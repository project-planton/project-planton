load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "modulebuild_lib",
    srcs = [
        "build.go",
        "main.go",
        "manifest.go",
        "modules.go",
        "pack.go",
    ],
    importpath = "github.com/plantonhq/planton/tools/modulebuild",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/detzip",
        "//pkg/downloads/modulemanifest",
    ],
)

go_binary(
    name = "modulebuild",
    embed = [":modulebuild_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "modulebuild_test",
    srcs = [
        "modulebuild_test.go",
        "workflows_test.go",
    ],
    embed = [":modulebuild_lib"],
    deps = [
        "//pkg/downloads/modulemanifest",
        "@io_k8s_sigs_yaml//:yaml",
    ],
)
